# =============================================================================
# AxiomLite Environment Configuration
# =============================================================================


# =============================================================================
# Core Django
# =============================================================================

SECRET_KEY=change-this-to-a-long-random-secret-key
DEBUG=TRUE

WEBSITE_TITLE=AxiomLite
SITE_ID=1

# Comma-separated
ALLOWED_HOSTS=127.0.0.1,localhost


# =============================================================================
# Render
# =============================================================================

# Automatically provided by Render in deployed services.
RENDER_EXTERNAL_HOSTNAME=


# =============================================================================
# Database
# =============================================================================

DATABASE_ENGINE=sqlite
SQLITE_NAME=db.sqlite3

# For MySQL:
# DATABASE_ENGINE=mysql

# DATABASE_NAME=axiomlite
# DATABASE_USER=root
# DATABASE_PASSWORD=your-password
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=3306

# For PostgreSQL:
# DATABASE_ENGINE=postgresql

# DATABASE_NAME=axiomlite
# DATABASE_USER=postgres
# DATABASE_PASSWORD=your-password
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432

# =============================================================================
# Internationalization
# =============================================================================

LANGUAGE_CODE=en
TIME_ZONE=UTC


# =============================================================================
# Static / Media
# =============================================================================

STATIC_URL=static/
STATIC_ROOT=staticfiles
STATICFILES_DIR=static

MEDIA_URL=/media/
MEDIA_ROOT=media

DEFAULT_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage

STATICFILES_STORAGE_BACKEND=whitenoise.storage.CompressedManifestStaticFilesStorage


# =============================================================================
# Passwords
# =============================================================================

PASSWORD_MIN_LENGTH=8


# =============================================================================
# Email
# =============================================================================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

EMAIL_USE_TLS=TRUE
EMAIL_USE_SSL=FALSE

EMAIL_TIMEOUT=30

DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=noreply@example.com


# =============================================================================
# django-allauth
# =============================================================================

# none
# mandatory
# optional

ACCOUNT_EMAIL_VERIFICATION=none

LOGIN_REDIRECT_URL=/
LOGIN_URL=accounts:sign-in

LOGOUT_REDIRECT_URL=/
LOGOUT_URL=accounts:sign-out


# =============================================================================
# django-axes
# =============================================================================

AXES_FAILURE_LIMIT=10
AXES_COOLOFF_SECONDS=1

# Comma-separated
AXES_LOCKOUT_PARAMETERS=ip_address


# =============================================================================
# Django REST Framework / OpenAPI
# =============================================================================

API_TITLE=AxiomLite API
API_VERSION=1.0.0
API_DESCRIPTION=AxiomLite API


# =============================================================================
# CORS / CSRF
# =============================================================================

# Comma-separated.
#
# Example:
# CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com

CORS_ALLOWED_ORIGINS=

CORS_ALLOW_CREDENTIALS=FALSE

# Comma-separated.
#
# Example:
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

CSRF_TRUSTED_ORIGINS=


# =============================================================================
# Redis
# =============================================================================

REDIS_CACHE_URL=redis://127.0.0.1:6379/0


# =============================================================================
# django-unfold
# =============================================================================

UNFOLD_SITE_TITLE=AxiomLite
UNFOLD_SITE_HEADER=AxiomLite
UNFOLD_SITE_SUBHEADER=Administration

UNFOLD_SITE_SYMBOL=shopping_cart

UNFOLD_SHOW_HISTORY=TRUE
UNFOLD_SHOW_VIEW_ON_SITE=TRUE

UNFOLD_SITE_DROPDOWN_TITLE=Visit AxiomLite
UNFOLD_SITE_DROPDOWN_LINK=/

UNFOLD_SIDEBAR_SEARCH=TRUE
UNFOLD_COMMAND_SEARCH=TRUE


# =============================================================================
# django-parler
# =============================================================================

PARLER_DEFAULT_LANGUAGE_CODE=en


# =============================================================================
# Uploads
# =============================================================================

# 10 MB
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760


# =============================================================================
# Security
# =============================================================================

X_FRAME_OPTIONS=DENY

SECURE_CONTENT_TYPE_NOSNIFF=TRUE

SESSION_COOKIE_HTTPONLY=TRUE
CSRF_COOKIE_HTTPONLY=TRUE

# Local development can use FALSE.
# Production HTTPS should use TRUE.

SESSION_COOKIE_SECURE=FALSE
CSRF_COOKIE_SECURE=FALSE

SECURE_SSL_REDIRECT=FALSE

# Set to 0 for local development.
# Production example:
# SECURE_HSTS_SECONDS=31536000

SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=FALSE
SECURE_HSTS_PRELOAD=FALSE

SECURE_REFERRER_POLICY=same-origin
SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin

USE_X_FORWARDED_HOST=FALSE

# Enable this when running behind a reverse proxy that correctly
# provides X-Forwarded-Proto: https.

SECURE_PROXY_SSL_HEADER_ENABLED=FALSE


# =============================================================================
# Sessions
# =============================================================================

# 14 days
SESSION_COOKIE_AGE=1209600

SESSION_SAVE_EVERY_REQUEST=FALSE
SESSION_EXPIRE_AT_BROWSER_CLOSE=FALSE


# =============================================================================
# Logging
# =============================================================================

LOG_LEVEL=INFO


# =============================================================================
# LM Studio
# =============================================================================

LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

LM_STUDIO_MODEL=empero-ai/qwen3.8-2b-distill

LM_STUDIO_TIMEOUT=30

LM_STUDIO_MAX_IMAGES=8


# =============================================================================
# Celery
# =============================================================================

CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

CELERY_TASK_TRACK_STARTED=TRUE

CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=270


# =============================================================================
# Questions
# =============================================================================

QUESTIONS_ENABLED=TRUE

QUESTIONS_SUBMISSION_MAX_CODE_SIZE=262144

QUESTIONS_MAX_TESTS_PER_QUESTION=100

QUESTIONS_DEFAULT_TIMEOUT=2
QUESTIONS_MAX_TIMEOUT=10

QUESTIONS_MAX_OUTPUT_SIZE=65536

QUESTIONS_MAX_EXECUTION_MEMORY=128m
QUESTIONS_MAX_EXECUTION_CPU=1

QUESTIONS_MAX_PROCESSES=32

QUESTIONS_MAX_CONCURRENT_EXECUTIONS=4

QUESTIONS_ALLOW_MANUAL_REVIEW=TRUE

QUESTIONS_SANITIZE_MARKDOWN=FALSE

QUESTIONS_EXECUTION_BACKEND=docker

QUESTIONS_PYTHON_IMAGE=questions-python:3.14-sandbox